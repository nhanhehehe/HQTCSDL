# Copy to backend/.env. Never commit credentials.
HQ_ENV=dev
# SQL login: URL-encode special characters in user/password.
# HQ_DATABASE_URL=mssql+pyodbc://app_user:ENCODED_PASSWORD@localhost:1433/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Windows integrated authentication alternative (omit user/password):
# HQ_DATABASE_URL=mssql+pyodbc://localhost/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# TrustServerCertificate=yes is for the local self-signed development instance.
# Test/demo must use their own database and credential; see docs/development.md.
# Optional separate migration account (falls back to HQ_DATABASE_URL for local bootstrap).
# HQ_MIGRATION_DATABASE_URL=mssql+pyodbc://migration_user:ENCODED_PASSWORD@localhost:1433/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
