# Copy to backend/.env. Never commit credentials.
HQ_ENV=dev
# Browser origin must exactly match the frontend URL (no trailing slash).
HQ_WEB_ORIGIN=http://127.0.0.1:5173
HQ_COOKIE_SECURE=false
# Required for auth; use a persistent independent random secret, never a real value here.
# HQ_CSRF_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Optional dedicated, disposable SQL Server test database; no fallback to runtime DB.
# HQ_AUTH_TEST_DATABASE_URL=mssql+pyodbc://test_user:ENCODED_PASSWORD@localhost/HQTCSDL_test?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# SQL login: URL-encode special characters in user/password.
# HQ_DATABASE_URL=mssql+pyodbc://app_user:ENCODED_PASSWORD@localhost:1433/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# Windows integrated authentication alternative (omit user/password):
# HQ_DATABASE_URL=mssql+pyodbc://localhost/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
# TrustServerCertificate=yes is for the local self-signed development instance.
# Dev/test/demo must use separate target databases/configurations.
# Local dev/test may reuse the two role-based logins (app/migration), with users
# and permissions mapped separately in each DB; see docs/development.md.
# Required for Alembic operations that load env.py (current/upgrade/downgrade/--sql).
# There is NO fallback to HQ_DATABASE_URL. Use the migration login, not the app login.
# For the first migration check, set this URL's DB to your dedicated test database.
# HQ_MIGRATION_DATABASE_URL=mssql+pyodbc://migration_user:ENCODED_PASSWORD@localhost:1433/HQTCSDL_dev?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# Independent persistent random secret for area/profile/credential pagination (do not reuse CSRF).
# HQ_CURSOR_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
# Change after a dataset restore/reset to invalidate old cursors.
HQ_DATASET_GENERATION=1
# Independent persistent random secret (>=32 UTF-8 bytes) for FL-13 report snapshots (distinct from CSRF/cursor).
# HQ_REPORT_SECRET=REPLACE_WITH_AN_INDEPENDENT_32PLUS_BYTE_RANDOM_SECRET
# Report snapshot TTL in seconds (positive integer, default 900 = 15 minutes).
HQ_REPORT_SNAPSHOT_TTL_SECONDS=900
# Optional JSON map of node timing profiles keyed by business device_id for FL-12 freshness.
# Example: HQ_NODE_TIME_PROFILES={"NODE-01":{"sampling_interval_seconds":60,"normal_delivery_budget_seconds":30}}
HQ_NODE_TIME_PROFILES={}
